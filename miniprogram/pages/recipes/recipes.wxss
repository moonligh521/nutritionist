.library {
  padding-bottom: 280rpx;
}

.segment {
  display: flex;
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 6rpx;
}

.segment text {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  color: #52605e;
}

.segment .on {
  background: #14b8a6;
  color: #ffffff;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 22rpx 4rpx 8rpx;
  color: #8a9694;
  font-size: 26rpx;
}

.filters text {
  flex-shrink: 0;
}

.filters .on {
  color: #14b8a6;
}

.sit-note {
  margin: 0 4rpx 8rpx;
}

.item {
  display: block;
  padding: 16rpx;
}

.main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.copy {
  flex: 1;
  min-width: 0;
}

.add {
  display: block;
  margin-top: 12rpx;
  text-align: right;
  color: #14b8a6;
  font-size: 26rpx;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #e7f6f3;
  flex-shrink: 0;
}

.name {
  font-size: 30rpx;
}

.add.added {
  color: #8a9694;
}

.dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #16332f;
  color: #ffffff;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  z-index: 6;
}

.dock-text {
  min-width: 0;
}

.dock-names {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 420rpx;
}

.dock-btn {
  flex-shrink: 0;
  background: #2ec4b6;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(22, 32, 30, 0.35);
  z-index: 7;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 8;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 650;
}

.suggest {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1px solid #eef3f2;
}

.sheet-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 24rpx;
}

.sheet-actions .primary {
  color: #14b8a6;
}
